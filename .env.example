# QuishGuard Configuration Environment Variables

# Flask Web Server
SECRET_KEY=quishguard-soc-production-secret-key-change-me
FLASK_DEBUG=True
PORT=5000

# Threat Intelligence APIs (Optional: If left blank, QuishGuard operates using offline curated IOCs and heuristics)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Inspection Limits
MAX_REDIRECT_HOPS=6
HTTP_TIMEOUT_SECONDS=5
MAX_CONTENT_LENGTH=16777216
